{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "_status": "DOCUMENTATION OF A SHAPE — no validator reads this file. Nothing in this engine imports jsonschema/ajv; CAPABILITY_MATRIX.json's `families` records follow this shape by convention, not by validation. Labelled 2026-08-23 (P8-081/P8-084).",
  "$id": ".engine-capability/v1",
  "title": "Engine capability record",
  "type": "object",
  "required": [
    "id",
    "path",
    "role",
    "decision"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "families": {
      "type": "array"
    },
    "formats": {
      "type": "array"
    },
    "tokens": {
      "type": "string"
    },
    "decision": {
      "enum": [
        "KEEP_EXISTING",
        "KEEP_AND_ADAPT",
        "UPGRADE_EXISTING",
        "ADD_ECHARTS",
        "ADD_SPECIALIST_ENGINE",
        "ADD_MCP",
        "DIRECT_ADAPTER_ONLY",
        "REPLACE_AFTER_VERIFIED_MIGRATION",
        "NOT_REQUIRED"
      ]
    }
  }
}
