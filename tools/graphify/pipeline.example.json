{
  "_readme": "Worked EXAMPLE pipeline (a security-scanner's scan->detect->AI->report flow) shipped so build-pipeline.mjs has something real to render out of the box. This is NOT your project's actual pipeline. Author your own file in this exact shape (steps: [id, label, module, lane, [downstream ids]]) and point engine.config.json's graphify.pipelineStepsFile at it — or set the ENGINE_GRAPHIFY_PIPELINE_STEPS_FILE env var — to describe your own flow as DATA instead of editing build-pipeline.mjs's source code.",
  "laneColors": { "in": "#10b981", "parse": "#f59e0b", "detect": "#e11d48", "know": "#8b5cf6", "ai": "#3b82f6", "cal": "#ec4899", "out": "#64748b" },
  "steps": [
