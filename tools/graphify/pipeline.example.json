    ["t0",        "T0 detectors (deterministic)",   "src/analysis/run_all_detectors (514)",              "detect", ["dynamic","knowledge","calibrate"]],
    ["dynamic",   "Dynamic / proof (opt)",          "src/dynamic/foundry",                               "detect", ["calibrate"]],
    ["knowledge", "Knowledge / RAG enrich",         "src/knowledge/rag (retrieve_for_finding, bank)",    "know",   ["t1","t2"]],
    ["t1",        "T1 AI (Haiku) — summarize",      "src/config/ai_routing (T1)",                        "ai",     ["report"]],
    ["t2",        "T2 AI (Sonnet/Opus) — reason",   "src/config/ai_routing (T2) · exploit chains",       "ai",     ["calibrate","report"]],
    ["calibrate", "Calibrate (oracle / suppress)",  "src/knowledge/{bank_suppression,calibration}",      "cal",    ["report"]],
